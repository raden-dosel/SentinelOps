# SentinelOps Server Environment Configuration
# Copy this file to .env in the /server directory to override defaults.

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=sentinelops
POSTGRES_USER=sentinelops
POSTGRES_PASSWORD=development-only
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# API Service Configuration
# ------------------------------------------------------------------------------
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# ------------------------------------------------------------------------------
# SentinelOps Sync Secrets
# In Production, provide high-entropy secrets (Cursor: >=32 chars, Token: >=16 chars)
# ------------------------------------------------------------------------------
SYNC_REGISTRATION_TOKEN=development-only-registration-token
SYNC_CURSOR_SIGNING_KEY=development-only-cursor-signing-key-minimum-32-chars

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# The origin URL of your SentinelOps tablet PWA / frontend
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGIN=http://localhost:3000
